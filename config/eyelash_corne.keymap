#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        lr_clk: lr_clk {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mkp>, <&mkp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <1 15 29>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "BASE";
            bindings = <
&kp ESCAPE      &kp Q  &kp W  &kp E         &kp R      &kp T                                        &mmv MOVE_UP                        &kp Y          &kp U          &kp I      &kp O    &kp P     &kp TAB
&kp CAPS        &kp A  &kp S  &kp D         &kp F      &kp G                        &mmv MOVE_LEFT  &lr_clk RCLK LCLK  &mmv MOVE_RIGHT  &kp H          &lt 3 J        &kp K      &kp L    &kp SEMI  &kp ENTER
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp V      &kp B              &tog 5                    &mmv MOVE_DOWN                      &kp N          &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp LEFT_WIN
                              &kp LEFT_ALT  &kp SPACE  &lt 1 LC(LA(TAB))                                                                &lt 2 LA(TAB)  &kp BACKSPACE  &kp LCTRL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        num_sym_layer {
            display-name = "NUMSYM";
            bindings = <
&kp INS  &kp SPACE     &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9  &kp BACKSPACE                               &kp UP_ARROW                     &kp GRAVE  &kp EXCLAMATION  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp AMPERSAND  &kp SINGLE_QUOTE
&trans   &kp NUMBER_0  &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6  &kp ENTER                   &kp LEFT_ARROW  &kp ENTER       &kp RIGHT_ARROW  &kp MINUS  &kp HASH         &kp ASTERISK          &kp CARET              &kp DOLLAR     &kp SINGLE_QUOTE
&trans   &kp DOT       &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3  &kp SPACE      &kp LNLCK                    &kp DOWN_ARROW                   &kp EQUAL  &kp AT_SIGN      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp BACKSLASH  &kp PERCENT
                                     &kp RIGHT_ALT  &kp RCTRL     &trans                                                                       &trans     &trans           &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        fn_layer {
            display-name = "FN";
            bindings = <
&kp ESCAPE  &kp F1        &kp F2        &kp F3        &kp F4        &kp F5                                           &msc SCRL_UP                     &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &kp BSPC
&kp TAB     &kp F11       &kp F12       &kp F13       &kp F14       &kp F15                          &msc SCRL_LEFT  &mkp MCLK       &msc SCRL_RIGHT  &kp F16       &kp F17       &kp F18       &kp F19       &kp F20       &none
&trans      &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp PAUSE_BREAK                    &msc SCRL_DOWN                   &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp LEFT_WIN
                                        &trans        &kp RCTRL     &none                                                                             &none         &kp SPACE     &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        nav_layer {
            display-name = "NAV";
            bindings = <
&none  &kp PAGE_UP   &kp RS(TAB)     &kp UP_ARROW  &kp TAB          &kp PAGE_DOWN                                &mmv MOVE_UP                     &none   &none          &kp MINUS        &kp EQUAL    &kp PAGE_UP    &kp HOME
&none  &kp HOME      &kp LEFT_ARROW  &kp DOWN      &kp RIGHT_ARROW  &kp END                      &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &none   &none          &kp LEFT_SHIFT   &none        &none          &none
&none  &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4     &kp NUMBER_5   &kp ESCAPE                    &mmv MOVE_DOWN                   &none   &none          &kp LS(LC(TAB))  &kp LC(TAB)  &kp PAGE_DOWN  &kp END
                                     &trans        &kp SPACE        &trans                                                                        &trans  &kp BACKSPACE  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        settings_layer {
            display-name = "SETTINGS";
            bindings = <
&none  &none  &none  &none       &none       &none                  &none         &rgb_ug RGB_BRI  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &none
&none  &none  &none  &bt BT_PRV  &bt BT_NXT  &none           &none  &none  &none  &rgb_ug RGB_TOG  &none            &none            &none            &none            &none
&none  &none  &none  &none       &none       &none  &none           &none         &rgb_ug RGB_BRD  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &none
                     &none       &none       &none                                &none            &none            &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        adjust_layer {
            display-name = "ADJUST";
            bindings = <
&kp ESCAPE      &none           &kp UP_ARROW    &none            &kp TAB    &none                          &none         &none  &none  &none  &none  &none  &kp DELETE
&kp LEFT_SHIFT  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none      &none                   &none  &none  &none  &none  &none  &none  &none  &none  &kp LA(LC(DELETE))
&kp LCTRL       &kp Z           &kp X           &none            &none      &none         &tog 5           &none         &none  &none  &none  &none  &none  &none
                                                &kp ENTER        &kp SPACE  &kp LEFT_ALT                                 &none  &none  &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        UTIL {
            if-layers = <1 2>;
            then-layer = <4>;
        };
    };
};
